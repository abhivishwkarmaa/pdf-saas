datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Job {
  id             String    @id @default(uuid())
  userId         String?
  batchId        String?
  toolSlug       String
  status         String    // queued, processing, completed, failed
  progress       Int       @default(0)
  speed          String?   // e.g. "1.2x"
  eta            String?   // e.g. "00:15"
  ffmpegProgress Int       @default(0)
  ffmpegSpeed    String?
  ffmpegEta      String?
  thumbnailKey   String?
  error          String?
  inputKeys      String[]
  outputKey      String?
  outputKeys     String[]
  mimeType       String?
  fileName       String?
  logs           String[]
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  completedAt    DateTime?
}

model Preset {
  id         String   @id @default(uuid())
  name       String
  format     String
  resolution String
  fps        String
  codec      String
  bitrate    String
  createdAt  DateTime @default(now())
}

model Conversion {
  id           String   @id @default(cuid())
  userId       String
  jobId        String
  inputFormat  String
  outputFormat String
  fileSizeMb   Float
  durationSec  Float?
  processingMs Int?
  plan         String
  createdAt    DateTime @default(now())
}

model ShareToken {
  id           String   @id @default(cuid())
  jobId        String   @unique
  token        String   @unique @default(cuid())
  expiresAt    DateTime
  downloads    Int      @default(0)
  maxDownloads Int      @default(10)
}

model ApiKey {
  id        String   @id @default(cuid())
  userId    String
  key       String   @unique
  name      String
  lastUsed  DateTime?
  requests  Int      @default(0)
  rateLimit Int      @default(100)
  createdAt DateTime @default(now())
  active    Boolean  @default(true)
}
